# Copy to .env and adjust. `just build` / `just up` create it from this file.

# --- Django ---
SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
ALLOWED_HOSTS=*
# DATABASE_URL is set by compose for the containers; override for host runs:
# DATABASE_URL=postgres://postgres@localhost:5432/gxauth

# --- OpenFGA ---
FGA_API_URL=http://openfga:8080
# Populate after `just fga-store-create`:
FGA_STORE_ID=
# Leave empty to use the store's latest model, or pin for reproducibility:
FGA_MODEL_ID=

# --- OIDC (Cognito today; Entra by overriding the endpoints) ---
# See docs/004-identity-and-tokens.md. Tokens are identity-only.
OIDC_ENABLED=false
# OIDC_RP_CLIENT_ID=
# OIDC_RP_CLIENT_SECRET=
# Cognito: set the domain + pool url and the endpoints are derived.
# OIDC_COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
# OIDC_COGNITO_POOL_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxx
# Entra: leave OIDC_COGNITO_* empty and set these four instead:
# OIDC_OP_AUTHORIZATION_ENDPOINT=
# OIDC_OP_TOKEN_ENDPOINT=
# OIDC_OP_USER_ENDPOINT=
# OIDC_OP_JWKS_ENDPOINT=
# OIDC_PROVIDER_NAME=cognito
# OIDC_REQUIRED_GROUP=
