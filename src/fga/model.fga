model
  schema 1.1

# Role-based access control (RBAC) with a nested project hierarchy.
# You assign USERS to ROLES on a project; PERMISSIONS are derived from roles.
# A role granted on a project flows DOWN to its descendant projects.
# See docs/002-authorization-model.md.

type user

# The platform itself: one object (e.g. `platform:gx`) holding operator-level
# roles for the gx-auth control plane. See docs/002 and ADR 0004.
type platform
  relations
    # Operators. May manage role grants on ANY project through the control
    # plane — including a brand-new project that has no admin yet.
    define admin: [user]
    # Services trusted to name the end user they act for (`on_behalf_of`) when
    # calling the control plane. Grants no access to any project by itself.
    define delegate: [user]

type project
  relations
    # The platform a project belongs to. The control plane supplies this edge
    # as a contextual tuple when it authorizes a grant, so platform admins can
    # manage grants on any project without it being stored. Nothing stores it
    # today, so platform admins hold no *data* access by default: to see a
    # project's contents they must grant themselves a role, which is audited.
    define platform: [platform]

    # parent project (top-level projects have no parent tuple).
    # Application enforces the max nesting depth and forbids cycles at write time;
    # it stays well under OpenFGA's resolve-node-limit (default 25).
    define parent: [project]

    # --- role assignments: the only thing you manage ---
    # Each role inherits itself from the parent project (downward inheritance).
    define admin: [user] or admin from parent or admin from platform
    define member: [user] or member from parent
    define viewer: [user] or viewer from parent

    # --- permissions: derived from roles; what apps Check ---
    define can_view: admin or member or viewer
    define can_create: admin or member
    define can_edit: admin or member
    define can_delete: admin
    define can_administer: admin

# Resources belong to a project and inherit its permissions. This adds no
# management burden — you still only ever assign roles on the project.

type sample
  relations
    define project: [project]
    define can_view: can_view from project
    define can_edit: can_edit from project
    define can_delete: can_delete from project

type analysis_output
  relations
    define project: [project]
    define can_view: can_view from project
    define can_edit: can_edit from project
    define can_delete: can_delete from project
